{
  "name": "nexus-activity",
  "version": "4.0.0",
  "description": "Nexus — لعبة تقمص أدوار تعمل كـ Discord Activity داخل القنوات",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "art": "node scripts/extract-art.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run art -- --check && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fontsource/tajawal": "^5.3.0",
    "@iconify-json/game-icons": "^1.2.4",
    "vite": "^8.3.6"
  }
}
