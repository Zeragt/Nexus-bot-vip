# ─────────────────────────────────────────────────────────────
#  Nexus — copy this file to .env and fill in your own values.
#  Never commit or share your real .env.
# ─────────────────────────────────────────────────────────────

# Discord (Developer Portal → your application)
DISCORD_TOKEN=
CLIENT_ID=
# Server ID: commands appear instantly there. Leave empty for global commands (up to 1 hour to appear).
GUILD_ID=

# Neon PostgreSQL — use the *pooled* connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional: the direct (non-pooler) URL. Only used by `npm run db:migrate` when MIGRATE_DIRECT=true.
DIRECT_URL=
# auto (TLS for remote hosts) | require | disable
DATABASE_SSL=auto
DATABASE_POOL_MAX=5

# Channel that receives the admin audit log (optional)
LOG_CHANNEL_ID=

# Permissions — Discord IDs, comma separated for several (never role names)
OWNER_USER_ID=
ADMIN_ROLE_ID=
MODERATOR_ROLE_ID=
EVENT_MANAGER_ROLE_ID=
LORE_MANAGER_ROLE_ID=
# Treat members with Discord's "Administrator" permission as bot admins
TRUST_DISCORD_ADMINISTRATOR=true

# Runtime
NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=true
# On every start: apply new database migrations / register slash commands if they changed
RUN_MIGRATIONS=true
DEPLOY_COMMANDS=true
# Needs "Message Content Intent" enabled in the Developer Portal (for RP XP by message length).
# If it isn't enabled the bot detects it and starts without it.
ENABLE_MESSAGE_CONTENT=true
# webp (fast, small) or png
IMAGE_FORMAT=webp
