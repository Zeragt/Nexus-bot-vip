# ═══ Discord (من https://discord.com/developers/applications) ═══
# Application ID من صفحة General Information
DISCORD_CLIENT_ID=
# من صفحة OAuth2 ← Client Secret (لا تشاركه مع أحد أبداً)
DISCORD_CLIENT_SECRET=

# ═══ قاعدة البيانات (Neon) ═══
# استخدم الرابط الذي فيه -pooler. بدون هذا السطر تُحفظ البيانات في ملف محلي للتجربة فقط.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ═══ الجلسات ═══
# نص عشوائي طويل (32 حرفاً أو أكثر). مثال لتوليده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ═══ أخرى ═══
# المنفذ (أغلب الاستضافات تحدده تلقائياً)
PORT=3001
# true يسمح بفتح اللعبة من المتصفح خارج Discord كضيف (للتجربة فقط، اتركه false على الإنتاج)
ALLOW_GUEST=false
